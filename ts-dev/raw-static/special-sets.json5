/**
 * special-sets — 特殊音集定义表(人工审核后命名的非 tertian 和弦)
 *
 * 本文件是 JSON5 源头,与 chord-formulas.json5 同级但独立——
 * 这里的条目不是三度堆叠和弦,不进入 chord 体系,是独立的 set。
 *
 * ── 为什么不用音程(Interval)而用半音数 ─────────────────────
 * 这些 set 本身就是因为「用标准音程体系解释会很混乱」才被单独命名的。
 * 用半音数定义最干净:根音 + [半音偏移量],无歧义、无记谱争议。
 *
 * ── 定义规则 ─────────────────────────────────────────────
 * offsets 只写根音之外的半音偏移量(不含 0,根音由引擎自动补):
 *   "offsets": [3, 4]  = 根音 + 3半音(小三度) + 4半音(大三度)
 * 与 chord 的 intervalList 不含根音一致。
 *
 * 生成实例时:for root in 0..11: 键集 = [root, ...offsets.map(o => (root + o) % 12)]
 *
 * ── 字段说明 ─────────────────────────────────────────────
 * setId         唯一标识(spset- 前缀),即对象的键
 * cnName        中文名
 * name          英文名
 * scoreDisplay  记谱原子(度数体系,非和弦符号——set 不是和弦,不用和弦记法):
 *               { "度数": 变化量 | [变化量, ...] } 对象形式,变化量 -1=♭ 0=♮ +1=♯。
 *               单音标量({"2": -1}),同度多音用数组({"3": [-1, 0]}——分叉三和弦
 *               ♭3·♮3、半音簇 ♭2·♮2)。与 degreeToIntervalMap 同族(度数做键)。
 *               原子化设计:消费端自行渲染升降号(♭2·♮4 等任意风格)。
 * offsets       半音偏移量数组(不含 0,升序)——原子的,一切的起点
 * tags          检索标签
 */
{
  // 分叉三和弦 · root + 3半音 + 4半音 · 布鲁斯「蓝调三度」的和声化表达
  // 大三与小三是并存关系而非替代关系;五度可省略;属七♯9 的三音版本
  // 分类:added-tone chord(非 tertian)
  // 来源:OERTX 大学教科书 / Wikipedia "Added tone chord" / Offtonic Theory §7.8
  // 审核:用户 2024-09-04
  "spset-split_third": {
    "cnName": "分叉三和弦",
    "name": "Split Third",
    "scoreDisplay": { "3": [-1, 0] },
    "offsets": [3, 4],
    "tags": ["blues", "non-tertian", "added-tone"]
  },

  // 半音簇 · root + 1半音 + 2半音 · 三个相邻半音同时发声
  // 非功能和声(secundal),存在理由是音色/色彩效果而非调性解决
  // Henry Cowell 钢琴音簇技法;20 世纪现代音乐(Penderecki/Ligeti)的音块写法
  // Forte 3-1;审核结论:不可用三度体系解释,12 个移调全部为 set
  // 来源:Wikipedia "Tone cluster" / Kostka & Payne / Reddit 共识
  // 审核:用户 2024-09-04
  "spset-chromatic_cluster": {
    "cnName": "半音簇",
    "name": "Chromatic Cluster",
    "scoreDisplay": { "2": [-1, 0] },
    "offsets": [1, 2],
    "tags": ["cluster", "secundal", "non-functional"]
  },

  // Phrygian 特征组 · root + 1半音(♭2) + 3半音(♭3) · 弗拉门戈/变化属的核心音响
  // 安达卢西亚终止式的灵魂(E-F-G over E pedal);7♭9 和弦中 ♭9+♭3 张力的三音浓缩
  // Forte 3-2(音程向量 <111000>);中东 hicaz tetrachord 的三音子集
  // 引擎的 chord 解释(Pmaj7sus2 omit5)技术上成立但丢失音乐身份
  // 来源:Ian Ring Scale Database / Flamenco Explained / Open Music Theory
  // 审核:用户 2024-09-04
  "spset-phrygian": {
    "cnName": "Phrygian三音",
    "name": "Phrygian Trichord",
    "scoreDisplay": { "2": -1, "3": -1 },
    "offsets": [1, 3],
    "tags": ["modal", "phrygian", "flamenco", "altered-dominant"]
  },

  // Hijaz 三音 · root + 1半音(♭2) + 4半音(♮3) · 中东/弗拉门戈 Phrygian dominant 音阶的特征组
  // 与 spset-phrygian 成对:♭2·♭3(安达卢西亚 E-F-G) vs ♭2·♮3(Hijaz E-F-G♯);
  // 也是 7♭9 的张力壳(root+♭9+大三度),与 phrygian 的 ♭9+♭3 浓缩互补
  // Forte 3-3(prime form 014)——恰为分叉三和弦 {0,3,4} 的倒影形:
  // 本库 prime form 不做倒影等价,3-3 类的 24 键集由 split_third 与本条各收一半
  // 双保留:本 set(C 根) + minmaj7(omit5)(P 根,cost=0 平行解释,set-exclusive 自动保留)
  // 来源:Open Music Theory set class 表 / Hijaz-Freygish 音阶文献 / Bartók-Schoenberg 014 集合
  // 审核:用户 2026-09-05(「C 是根音 Hijaz 对,P 是根音 minmaj7 也对,同时保留」)
  "spset-hijaz": {
    "cnName": "Hijaz三音",
    "name": "Hijaz Trichord",
    "scoreDisplay": { "2": -1, "3": 0 },
    "offsets": [1, 4],
    "tags": ["modal", "phrygian-dominant", "hijaz", "flamenco", "altered-dominant"]
  },

  // Viennese 三音 · root + 1半音(♭2) + 6半音(♭5) · 第二维也纳乐派的标志细胞
  // Schoenberg op.11/3 终止处、Berg、Webern 高频;无调性张力音响(半音+三全音)。
  // 与 Phrygian(♭2·♭3)/Hijaz(♭2·3) 构成 R+♭2+X 特征音组家族,X=♭5。
  // 身份性质略异:名字来自学院集合论分析(作曲家用此音响但不这么叫),
  // 但用户裁决采纳——它给 C-P-X 形补上 C 根音视角,与 P 根的 maj7sus4
  // 壳构成双根音双保留(set[C 根] + maj7sus4(omit5)[P 根])。
  // Forte 3-5,音程向量 [100011];★类第 4 个裁决(3-1/3-2/3-3 之后)。
  // 来源:Music Theory Online(Jack Boss)/ Cambridge 勋伯格研究 / Forte 名录
  // 审核:用户 2026-09-05
  "spset-viennese": {
    "cnName": "Viennese三音",
    "name": "Viennese Trichord",
    "scoreDisplay": { "2": -1, "5": -1 },
    "offsets": [1, 6],
    "tags": ["atonal", "second-viennese-school", "tritone", "post-tonal"]
  },

  // Phrygian 挂留三音 · root + 1半音(♭2) + 5半音(纯四) · B-C-E / C-D♭-F 型
  // 功能:7sus4♭9 的张力浓缩(root+sus4+♭9,变化属的挂留形)——Phrygian 调式
  // 的 1-♭2-4,弗拉门戈安达卢西亚终止的挂留版,与 spset-phrygian(特征版
  // ♭2+♭3)配对:Phrygian 和声的挂留/张力两浓缩。
  // R+♭2+X 家族 X=5 员,家族就此补全(X=2..6 连续):
  //   半音簇 ♭2·2 / Phrygian特征 ♭2·♭3 / Hijaz ♭2·3 / 本条 ♭2·4 / Viennese ♭2·♭5
  // Forte 3-4 正形(与倒影形 {0,1,8} maj3add11 壳分领一类);
  // 双根音用法:set 根 = 半音对低音(摩擦挂身),maj7 壳根 = 半音对高音
  // 审核:用户 2026-09-05(命名功能化:突出「Phrygian+挂留」的调式功能)
  "spset-phrygian_sus": {
    "cnName": "Phrygian挂留三音",
    "name": "Phrygian Suspended Trichord",
    "scoreDisplay": { "2": -1, "4": 0 },
    "offsets": [1, 5],
    "tags": ["phrygian", "sus", "altered-dominant", "flamenco"]
  }
}
