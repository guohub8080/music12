/**
 * special-sets — 特殊音集定义表(人工审核后命名的非 tertian 和弦)
 *
 * 本文件是 JSON5 源头,与 chord-formulas.json5 同级但独立——
 * 这里的条目不是三度堆叠和弦,不进入 chord 体系,是独立的 set。
 *
 * ── 为什么不用音程(Interval)而用半音数 ─────────────────────
 * 这些 set 本身就是因为「用标准音程体系解释会很混乱」才被单独命名的。
 * 用半音数定义最干净:根音 + [半音偏移量],无歧义、无记谱争议。
 *
 * ── 定义规则 ─────────────────────────────────────────────
 * offsets 只写根音之外的半音偏移量(不含 0,根音由引擎自动补):
 *   "offsets": [3, 4]  = 根音 + 3半音(小三度) + 4半音(大三度)
 * 与 chord 的 intervalList 不含根音一致。
 *
 * 生成实例时:for root in 0..11: 键集 = [root, ...offsets.map(o => (root + o) % 12)]
 *
 * ── 字段说明 ─────────────────────────────────────────────
 * setId         唯一标识(spset- 前缀),即对象的键
 * cnName        中文名
 * name          英文名
 * scoreDisplay  记谱符号(度数体系,非和弦符号——set 不是和弦,不用和弦记法)
 * offsets       半音偏移量数组(不含 0,升序)——原子的,一切的起点
 * tags          检索标签
 */
{
  // 分叉三和弦 · root + 3半音 + 4半音 · 布鲁斯「蓝调三度」的和声化表达
  // 大三与小三是并存关系而非替代关系;五度可省略;属七♯9 的三音版本
  // 分类:added-tone chord(非 tertian)
  // 来源:OERTX 大学教科书 / Wikipedia "Added tone chord" / Offtonic Theory §7.8
  // 审核:用户 2024-09-04
  "spset-split_third": {
    "cnName": "分叉三和弦",
    "name": "Split Third",
    "scoreDisplay": "♭3·3",
    "offsets": [3, 4],
    "tags": ["blues", "non-tertian", "added-tone"]
  },

  // 半音簇 · root + 1半音 + 2半音 · 三个相邻半音同时发声
  // 非功能和声(secundal),存在理由是音色/色彩效果而非调性解决
  // Henry Cowell 钢琴音簇技法;20 世纪现代音乐(Penderecki/Ligeti)的音块写法
  // Forte 3-1;审核结论:不可用三度体系解释,12 个移调全部为 set
  // 来源:Wikipedia "Tone cluster" / Kostka & Payne / Reddit 共识
  // 审核:用户 2024-09-04
  "spset-chromatic_cluster": {
    "cnName": "半音簇",
    "name": "Chromatic Cluster",
    "scoreDisplay": "♭2·2",
    "offsets": [1, 2],
    "tags": ["cluster", "secundal", "non-functional"]
  },

  // Phrygian 特征组 · root + 1半音(♭2) + 3半音(♭3) · 弗拉门戈/变化属的核心音响
  // 安达卢西亚终止式的灵魂(E-F-G over E pedal);7♭9 和弦中 ♭9+♭3 张力的三音浓缩
  // Forte 3-2(音程向量 <111000>);中东 hicaz tetrachord 的三音子集
  // 引擎的 chord 解释(Pmaj7sus2 omit5)技术上成立但丢失音乐身份
  // 来源:Ian Ring Scale Database / Flamenco Explained / Open Music Theory
  // 审核:用户 2024-09-04
  "spset-phrygian": {
    "cnName": "Phrygian 特征组",
    "name": "Phrygian Trichord",
    "scoreDisplay": "♭2·♭3",
    "offsets": [1, 3],
    "tags": ["modal", "phrygian", "flamenco", "altered-dominant"]
  }
}
