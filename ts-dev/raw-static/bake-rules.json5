/**
 * bake-rules — 烘焙保留规则的正式定义(人工可改的唯一源头)
 *
 * 在此之前,「哈希表里保留哪些条目」的规则散落在 bake.ts 代码与
 * theory.md/README.md 的文字描述里,没有真正可审计的定义。
 * 本文件把保留逻辑数据化为三层管线,bake.ts 逐层执行:
 *
 *   ┌─ 机器 ─────────────────────────────────────────────────┐
 *   │ 穷举 C(12,n) → 倒推引擎 → 加权 cost → tier 分组          │
 *   └──────────────────────┬────────────────────────────────┘
 *                          ▼
 *   第一层 policy     通用策略:每键集最多几条、tier 上限(机械截断)
 *   第二层 rules      类型化规则:声明式 when/then,机器自动套用
 *   第三层 verdicts   人工裁决:逐键集钦定保留,优先级最高
 *                          ▼
 *   固化 → static-data/chord-hash-*.json + 报告标注来源
 *
 * 三层与人机协作的关系:
 *   - rules 管 99% 的情况(模式化噪音过滤),改一处全表生效
 *   - verdicts 管机器模式覆盖不了的特殊判断(乐理争议/顺序钦定),
 *     是人工审核 hash3-report.md 之后的正式产物
 *   - verdicts 的键是移调规范形(prime form),如 "0,1,3" ——
 *     人工审核一次,自动对称作用于全部 12 个移调
 *
 * ── 字段说明 ─────────────────────────────────────────────
 * policy.maxEntries   每键集最多保留条数(截断,顺序在截断前已定)
 * policy.tierCeiling  tier 上限,超过的条目不进哈希表(查询走 pcset 降级)
 *
 * rules[].id          规则 id(报告引用;bake.ts 按字段直读,非 DSL 解释器)
 * rules[].enabled     开关(false = 保留定义但不生效,留作历史)
 * rules[].when        触发条件:hasSetHit(有 set 完全命中)
 *                      / hasExactMatch(有零变换完全命中条目,tier1 且 n="")
 * rules[].then        动作:filterChords.costMax(过滤 cost 超过该值的 chord 条目)
 *                      / keepOnly="exactMatch"(只留完全命中条目,其余全滤;
 *                        set 条目不受规则影响,等和弦的多名全保留)
 *
 * verdicts[key]       key = prime form(移调规范形),工具函数 keyset.ts
 * verdicts[key].anchor    锚点 set id(spset-xxx):在该键集上唯一确定根音,
 *                          keep 里的 chord 根音以锚点根音为基准
 * verdicts[key].keep[]    人工钦定保留列表:顺序即最终顺序
 *   { type: "anchor" }                          锚点 set 条目本身
 *   { type: "chord", formula, rootShift }       有 anchor:根音 = 锚点根音 + rootShift
 *   { type: "chord", formula, rootRel }         无 anchor(纯 chord 键集):
 *                                                根音 = prime form 起点音 + rootRel
 * (两种偏移都保持移调对称:一处裁决,12 个移调各自命中正确的根音)
 * verdicts[key].filterRest  true = 未列入 keep 的全部过滤
 *                           false = keep 置顶,其余按机器顺序殿后
 *
 * 运行:改本文件 → pnpm gen:static-data → npx tsx ts-dev/decompose/bake.ts
 * 匹配不到的 keep 条目会在 bake 时警告(人工数据过期的信号,不静默)。
 */
{
  // ── 第一层:通用策略(机械截断)──────────────────────────────
  "policy": {
    // 三音空间条目密度不高,10 条足够;tier 上限 6 = 全保留(占位,收紧时改这里)
    "maxEntries": 10,
    "tierCeiling": 6,
  },

  // ── 第二层:类型化规则(机器自动套用)────────────────────────
  "rules": [
    {
      // 零成本独占(普适):存在 cost=0 的 chord 解释(完全命中或纯省略)时,
      // 保留全部零成本条目,滤掉 cost>0 的扭曲解释——Tier2 纯省略组同样
      // 适用(144 组的 1296 条挂尾一次清掉)。
      //
      // 乐理依据:cost=0 是「零扭曲」线——完全命中(键集恰等于公式音集)
      // 与纯省略(omit5/omit11 预期行为)都不扭曲和弦身份;cost>0 的
      // add/alter 才开始扭曲。等和弦多名(C6/Am7、sus2/sus4、dim7 四重名)
      // 与省略并列解释(如 CDEG 的 Ddom9sus4(omit5),sus 声部视角)
      // 全部零扭曲,全部保留;滤掉的是 tier3+ 凑数解释。
      //
      // 演化:2026-09-05 初版 exact-exclusive(只留完全命中)→ 同日用户
      // 四音审核 CDEG 案例放宽——Ddom9sus4(omit5) cost=0 是准确的
      // sus 声部解释,「cost0 的都纳入不过滤的范围」。
      // set 命中组由 set-exclusive/verdicts 接管,优先级更高。
      "id": "zero-cost-exclusive",
      "enabled": true,
      "when": { "hasZeroCostChord": true },
      "then": { "keepOnly": "zeroCost" },
    },
    {
      // 同根音完全命中优先:cost=0 并列中,同一根音既有完全命中(零变换)
      // 又有带变换条目时,只留无变换的——省略记法还原后与完全命中等价,
      // 同根音下是冗余记法(不同根音的 cost=0 全保留,那是等和弦多视角)。
      //
      // 典型:BCEX {0,4,6,11} 同为 C 根的 Cmaj7b5(完全命中)与
      // Cmaj7#11(omit5)(#11≡b5 等音,omit5 后音集相同)→ 留 maj7b5。
      //
      // 审定:用户 2026-09-06(四音审核;「再次提醒:只有同根音才滤,
      // 根音不同就都保留」)
      "id": "same-root-exact-preferred",
      "enabled": true,
      "when": { "hasExactMatch": true },
      "then": { "prefer": "transformless-per-root" },
    },
    {
      // set 独占规则:set 完全命中时,chord 只保留 cost=0 的平行解释
      //
      // 乐理依据(theory.md):当键集被人工审核认定为独立 set(如 Phrygian 三音),
      // 该键集已有「最强解释」——set 本身。cost=0 的 chord 解释(如 Phrygian ≡
      // maj7sus2 减五度子集)是数学恒等,保留供记谱参考;cost>0 的 chord 解释
      // 是为了凑数而扭曲的弱解释,在强解释面前是噪音。
      //
      // 审定:用户 2026-09-04(C-D-B 案例:保留 B·Phrygian + Cmaj7sus2(omit5),
      // 过滤 sus2(omit5 add7) 及以下的 tier3+ 解释)
      "id": "set-exclusive",
      "enabled": true,
      "when": { "hasSetHit": true },
      "then": { "filterChords": { "costMax": 0 } },
    },
  ],

  // ── 第三层:人工裁决(优先级最高)────────────────────────────
  "verdicts": {
    // Phrygian 三音形(Forte 3-2):C-D-B / C#-D-E / ... 共 12 个移调
    //
    // 本形已由 set-exclusive 规则覆盖(set + maj7sus2(omit5) 平行解释),
    // 此处显式钦定为示范条目:固化讨论结论 + 锁定顺序(set 在前,平行解释在后),
    // 并留下审核痕迹。规则覆盖不了的争议键集,才真正需要 verdict 出场。
    //
    // 审核:用户 2026-09-04
    "0,1,3": {
      "date": "2026-09-04",
      "comment": "Phrygian 三音为主解释(弗拉门戈/安达卢西亚终止核心音响);maj7sus2(omit5) 为数学恒等(cost=0),保留供记谱参考",
      "anchor": "spset-phrygian",
      "keep": [
        { "type": "anchor" },
        { "type": "chord", "formula": "maj7sus2", "rootShift": 1 },
      ],
      "filterRest": true,
    },

    // 半音簇形(Forte 3-1):C-P-D / P-D-Q / ... 共 12 个移调
    //
    // 硬规则:纯 set,不保留任何 chord 平行解释。
    // 决策变更:2026-09-04 曾软保留 maj7sus2(♭2 omit5)(cost=1.5,
    // sus 单变化);2026-09-05 用户复审改判——它是凑数解释而非数学恒等
    // (对比 Phrygian 形的 maj7sus2(omit5) 是 cost=0 恒等,够格;这里的
    // ♭2 变换是硬凑),不够格保留。半音簇本身非功能(secundal),chord
    // 体系读法都是扭曲,与分叉三和弦同款硬规则。
    //
    // 审核:用户 2026-09-04 初判软保留 → 2026-09-05 改判硬规则
    "0,1,2": {
      "date": "2026-09-05",
      "comment": "半音簇为唯一解释(硬规则):maj7sus2(♭2 omit5) 是 cost=1.5 凑数非恒等,改判不保留,纯 set",
      "anchor": "spset-chromatic_cluster",
      "keep": [{ "type": "anchor" }],
      "filterRest": true,
    },

    // 分叉三和弦形:A-C-C# / C-E♭-E / ... 共 12 个移调
    // (prime form = 0,1,9,即 C# 起点的紧致形 [0,1,9];C 根形态 [0,3,4]
    //  数值更大,不是规范键——键必须是 primeForm() 的输出)
    //
    // 硬规则:纯 set,不保留任何 chord 平行解释。
    // 分叉三度的定义就是大/小三度并存(♪3+3),这在三度堆叠体系内
    // 本质不可表达——任何 chord 解释都要 add3 或等价扭曲(cost≥3,
    // 全部 tier5+)。与 Phrygian(maj7sus2 数学恒等)和半音簇(sus 单
    // 变化平行读法)不同:后两者有低 cost 的亲缘解释,这里没有。
    //
    // 现状恰好只剩 set(因无 cost=0 解释),但那是 cost 函数碰巧,
    // 非声明——固化后调 cost 权重也不会意外放进 chord 解释。
    //
    // 审核:用户 2026-09-04
    "0,1,9": {
      "date": "2026-09-04",
      "comment": "分叉三和弦为唯一解释(硬规则):大/小三度并存本质不可 tertian 表达,任何 chord 解释都是扭曲,全滤",
      "anchor": "spset-split_third",
      "keep": [{ "type": "anchor" }],
      "filterRest": true,
    },

    // 减三和弦形:C-E♭-G♭ / ... 共 12 个移调(prime form 0,3,6 自规范)
    //
    // 硬规则:完全命中即唯一解释。Cdim3(tier1,cost=0 零变换)已是完美
    // 答案;其余条目全是噪音——Qdim7(omit5) 是 dim7 对称性的副产品
    // (C-E♭-G♭ 恰为 E♭dim7 减五度),min3add6/dom7 系是换根音的凑数
    // 解释,在完美答案面前没有参考价值。
    //
    // 本条同时示范无锚模式:键集无 set 命中,不用 anchor,
    // chord 条目用 rootRel(相对 prime form 起点的偏移)定根音。
    //
    // 审核:用户 2026-09-05
    "0,3,6": {
      "date": "2026-09-05",
      "comment": "减三和弦完全命中即唯一解释:dim7 对称性副产品与换根音凑数解释全滤",
      "keep": [
        { "type": "chord", "formula": "dim3", "rootRel": 0 },
      ],
      "filterRest": true,
    },

    // 半音叠纯四形:C-C♯-F / C-E-B / ... 共 12 个移调(prime form 0,1,5,Forte 3-4 正形)
    //
    // 双根音双保留(set 角度解释和弦现象——用户「创新」裁决):
    //   set 根 = 半音对低音:C·Phrygian挂留三音(♭2+纯四,7sus4♭9 张力浓缩,
    //           R+♭2+X 家族 X=5,家族就此补全)
    //   maj7 壳根 = 半音对高音:Pmaj7(omit5)(cost=0,纯省略零扭曲)
    // 二度对两音各领一个身份:低音挂摩擦(set),高音展度数(chord)。
    // tier3+ 挂尾仍全滤;Paugmaj7 等已由变音度数引擎规则消灭。
    //
    // 审核:用户 2026-09-05(先裁纯 chord 硬规则,同日升级 set+maj7 壳双保留)
    "0,1,5": {
      "date": "2026-09-05",
      "comment": "Phrygian挂留三音(半音对低音根,♭2+纯四)+ maj7(omit5)(半音对高音根)双保留",
      "anchor": "spset-phrygian_sus",
      "keep": [
        { "type": "anchor" },
        { "type": "chord", "formula": "maj7", "rootShift": 1 },
      ],
      "filterRest": true,
    },

    // Viennese + maj7sus4 双根音形:C-C♯-F♯ / ... 共 12 个移调(prime form 0,1,6,Forte 3-5)
    //
    // 软保留(双根音双身份):C 根 = Viennese三音(set,♭2+♭5 集合身份,
    // 第二维也纳乐派标志细胞);P 根 = maj7sus4(omit5)(cost=0,quartal
    // 爵士壳)。用户裁决理由:「按 Viennese 的话就是 C 根音了」——多根音
    // 解释都公认时全保留(与 Hijaz 形同款)。tier3+ 挂尾仍全滤。
    //
    // 审核:用户 2026-09-05(先裁纯 chord 硬规则,同日升级双根音软保留)
    "0,1,6": {
      "date": "2026-09-05",
      "comment": "Viennese三音(C 根,集合身份)+ maj7sus4(omit5)(P 根,爵士壳)双保留",
      "anchor": "spset-viennese",
      "keep": [
        { "type": "anchor" },
        { "type": "chord", "formula": "maj7sus4", "rootShift": 1 },
      ],
      "filterRest": true,
    },

    // dom7 减五形:C-F♯-G♯ / ... 共 12 个移调(prime form 0,2,6,起点是三全音音;
    // C 根形态 [0,6,8] 非规范键)
    //
    // 硬规则:只保留 dom7(omit5)。输入 = 属七的三音壳(root+M3+b7,
    // guide tones 齐全的 rootless 前身,爵士 shell voicing 的本体),
    // 纯省略零扭曲;tier3+ 挂尾全滤。无锚模式:根音 = 起点 + 2。
    //
    // 审核:用户 2026-09-05
    // 全音叠三全音形(dom7 壳形):F♯-G♯-C / ... 共 12 个移调(prime form 0,2,6,Forte 3-8 正形)
    //
    // 双根音双保留(「set 根=二度对低音」规律推广,用户 2026-09-05 确认):
    //   set 根 = 全音对低音:X·全音叠三全音(♮2+♭5)
    //   dom7 壳根 = 全音对高音:Ydom7(omit5)(cost=0,guide tones 壳)
    //
    // 审核:用户 2026-09-05(先裁纯 chord 硬规则,同日升级双保留)
    "0,2,6": {
      "date": "2026-09-05",
      "comment": "全音叠三全音(二度对低音根)+ dom7(omit5)(二度对高音根)双保留",
      "anchor": "spset-tone_tritone",
      "keep": [
        { "type": "anchor" },
        { "type": "chord", "formula": "dom7", "rootShift": 2 },
      ],
      "filterRest": true,
    },

    // 全音对形(Forte 3-6):C-D-E / ... 共 12 个移调(prime form 0,2,4 自规范)
    //
    // 双根音双保留(不升 set——「全音三音」身份未采纳,★类 3-6 裁决):
    //   C 根 = maj3(omit5 add2):add2 记法而非 add9——三音语境无八度
    //   支撑,D 距 C 是大二度不是九度,add2 更诚实(cost 0.5 用户钦定)
    //   D 根 = dom7sus2(omit5)(cost=0)
    // Cmaj3add9(omit5) 同事实的 add9 记法条目不保留(名不副实)。
    // 无锚模式:maj3 根音 = 起点 + 0,dom7sus2 根音 = 起点 + 2。
    //
    // 审核:用户 2026-09-05
    "0,2,4": {
      "date": "2026-09-05",
      "comment": "双根音双保留:C 根 maj3(omit5 add2)(add2 记法诚实于三音语境)+ D 根 dom7sus2(omit5);add9 记法与挂尾全滤",
      "keep": [
        { "type": "chord", "formula": "maj3", "rootRel": 0 },
        { "type": "chord", "formula": "dom7sus2", "rootRel": 2 },
      ],
      "filterRest": true,
    },

    // 四度碎片倒影形(Forte 3-7 的另一半):F-A♭-B♭ / ... 共 12 个移调
    // (prime form 0,2,9;与 {0,2,5} 形互为倒影,同 3-7 类分裂,
    // 如同 hijaz/split_third 之于 3-3)
    //
    // 硬规则:只保留 min3add11(omit5)。F-A♭-B♭ = 小三 + 纯四
    // (min11 省五度三音壳,也是 F 小五声的特征碎片);其余挂尾全滤。
    // 无锚模式:min3add11 根音 = 起点 + 9。
    //
    // 审核:用户 2026-09-05
    "0,2,9": {
      "date": "2026-09-05",
      "comment": "min3add11(omit5) 为唯一解释(硬规则):小三+纯四五声碎片,挂尾全滤",
      "keep": [
        { "type": "chord", "formula": "min3add11", "rootRel": 9 },
      ],
      "filterRest": true,
    },

    // 半音叠纯四倒影形(Forte 3-4 的另一半):F-A-B♭ / ... 共 12 个移调
    // (prime form 0,1,8;与 {0,1,5} 形互为倒影——正形半边已裁
    // maj7(omit5),本形两半对称收编:maj7 壳 vs maj3add11 壳)
    //
    // 硬规则:只保留 maj3add11(omit5)。F-A-B♭ = 大三 + 纯四
    // (maj3add11 省五度三音壳,大调 1-3-4 音组);其余挂尾全滤。
    // 无锚模式:maj3add11 根音 = 起点 + 8。
    //
    // 审核:用户 2026-09-05
    "0,1,8": {
      "date": "2026-09-05",
      "comment": "maj3add11(omit5) 为唯一解释(硬规则):大三+纯四壳,与正形半边 maj7 壳对称,挂尾全滤",
      "keep": [
        { "type": "chord", "formula": "maj3add11", "rootRel": 8 },
      ],
      "filterRest": true,
    },

    // 四度碎片正形(Forte 3-7 正半边,★类最后一形):F♯-G♯-B / C-D-F / ...
    // 共 12 个移调(prime form 0,2,5;与倒影半边 {0,2,9} 互为倒影——
    // 倒影半边已裁 min3add11(omit5),本形收编 min7 壳,★类就此收官)
    //
    // 硬规则:只保留 min7(omit5)。输入 = 小七的三音壳
    // (root+m3+b7,guide tones 齐全,与 \"0,2,6\" 形的 dom7(omit5) 壳
    // 同构——一个是小七壳一个是属七壳);其余挂尾全滤。
    // 无锚模式:min7 根音 = 起点 + 2。
    //
    // 审核:用户 2026-09-05
    // 四度碎片形(min7 壳形):C-D-F / ... 共 12 个移调(prime form 0,2,5,Forte 3-7 正形)
    //
    // 双根音双保留(「set 根=二度对低音」规律推广,用户 2026-09-05 确认):
    //   set 根 = 全音对低音:C·四度碎片(♮2+♮4,大调 1-2-4)
