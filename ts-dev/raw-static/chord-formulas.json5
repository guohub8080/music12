  },


  // maj13sus2 · 大十三挂二 · C-D-G-B-A · maj2=2 p5=7 maj7=11 maj13=21
  //   大十三挂二和弦，在大十三和弦基础上用大二度音替代三度音
  "maj13sus2": {
