  "dom9b13": {
  "$base": "dom9",
  "$add": [["min", 13]],
  "cnName": "属九减十三",
  "name": "Dominant 9th Flat 13",
  "scoreDisplay": "9b13"
  },


  // dom9add13 · 属九加十三 · C-E-G-B♭-D-A · maj3=4 p5=7 min7=10 maj9=14 maj13=21
