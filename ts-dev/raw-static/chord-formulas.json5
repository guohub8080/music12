  "dom9b5": {
  "$base": "dom9",
  "$set": {"5": "dim"},
  "cnName": "属九减五",
  "name": "Dominant 9th Flat 5",
  "scoreDisplay": "9b5"
  },


  // dom9#11 · 属九增十一 · C-E-G-B♭-D-F♯ · maj3=4 p5=7 min7=10 maj9=14 aug11=18
  //   属九增十一和弦，在属九和弦基础上增加增十一度音
  "dom9#11": {
  "$base": "dom9",
  "$add": [["aug", 11]],
  "cnName": "属九增十一",
  "name": "Dominant 9th Sharp 11",
  "scoreDisplay": "9#11"
  },


  // dom9b13 · 属九减十三 · C-E-G-B♭-D-A♭ · maj3=4 p5=7 min7=10 maj9=14 min13=20
