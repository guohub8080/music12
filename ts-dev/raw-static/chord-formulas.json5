/**
 * chord-formulas — 和弦公式定义表(88 个,极简源 + 基座引用)
 *
 * 本文件是 JSON5 源头,编译产物为 static-data/chord-formulas.json(gen:static-data 展开)。
 * 手改只改这里;产物永不手改。展开正确性由 ts-dev/verify/verifyChordFormulas.ts 兜底。
 *
 * ── 极简原则 ─────────────────────────────────────────────
 * 每条只写不可推导的真信息:键(id) + intervalList(或基座引用) +
 * cnName/name/scoreDisplay 三名。派生字段一律不存,编译时算回:
 *   semitonesList       gap(type,N) = 同型简单度数半音 + 12×((N-1)//7)
 *   notesNum            intervalList 长度 + 1
 *   degreeToIntervalMap intervalList 的 map 形态
 *   tags                deriveTags(intervalList) 注入(五维:基因/扩展/性质/变音/结构)
 *   family              已删(v1/v2 目录名化石,与 tags 无对应,勿复活)
 *   description         已删(职责由每条第二行注释承载)
 *   chordFormulaId      编译时从键回填
 *
 * ── 基座引用 DSL(三键,可组合) ─────────────────────────
 *   $base  基座公式 id,继承其 intervalList(可链式:dom13→dom11→dom9→dom7→maj3)
 *   $set   {度数: 性质} 替换基座中该度数的性质(dom7#5 = dom7 + $set{5:aug})
 *   $add   [[性质, 度数],...] 追加扩展音(dom9 = dom7 + $add[[maj,9]])
 * 展开顺序:递归展开 $base → 应用 $set → 应用 $add → 按度数升序。
 * 全表 6 个完整定义(树根,基础三和弦/挂留):
 *   maj3 min3 dim3 aug3 sus2 sus4;其余 82 个基座化,
 * intervalList 音数 359 → 94(压缩 74%)。
 *
 * 基座规则(无环 + 乐理双重保证,编译器必须遵守):
 *   1. 偏序:基座的「度数+性质秩」序列必须严格小于目标的序列。
 *      性质秩:p=0, maj=0(基准), min=1, aug=2, dim=2(变音), aug+/dim-=3。
 *      严格偏序 → 引用图天然 DAG(maj3↔min3 互指成环的历史教训)。
 *   2. $set 仅限同名前缀的变音(dom7#5 基于 dom7);跨 id 禁用 set——
 *      maj3/min3/dim3/aug3 是平级基础和弦,不是相互修改出来的。
 *   3. $add 任意合法基座(堆叠视角):dom7 = maj3+min7, halfdim7 = dim3+min7
 *      (减小七), dim7 = dim3+dim7(减减七), minmaj7 = min3+maj7(小大七)。
 *   4. 基座选择:操作数最少者优先;平手同名前缀优先(名字即意图);再平手按键序。
 *
 * ── 记录注释格式(展开快照) ──────────────────────────────
 * 两行注释展示「展开后」的完整面貌(弥补基座引用不直读的代价):
 *   第一行:id · 中文名 · C 为根正确拼法 · 音程=半音列表(复合音程含八度,maj9=14)
 *   第二行:人读描述(原 description)
 *
 * ── 度数体系 ─────────────────────────────────────────────
 * 出现 {2,3,4,5,6,7,9,11,13},无 8/10/12;sus2 用 maj2(大二度,二度无「纯」);
 * 9/11/13 为复合音程。拼法按乐理推(#9 拼作 D♯,减七度拼作 B♭♭ — 等音 A)。
 */
{
  // maj3 · 大三 · C-E-G · maj3=4 p5=7
  //   大三和弦，根音、大三度、纯五度构成,是最基本的和弦之一
  "maj3": {
  "intervalList": [["maj", 3], ["p", 5]],
  "cnName": "大三",
  "name": "Major"
  },


  // min3 · 小三 · C-E♭-G · min3=3 p5=7
  //   小三和弦,根音、小三度、纯五度构成
  "min3": {
  "intervalList": [["min", 3], ["p", 5]],
  "cnName": "小三",
  "name": "Minor",
  "scoreDisplay": "m"
  },


  // dim3 · 减三 · C-E♭-G♭ · min3=3 dim5=6
  //   减三和弦,根音、小三度、减五度构成
  "dim3": {
  "intervalList": [["min", 3], ["dim", 5]],
  "cnName": "减三",
  "name": "Diminished",
  "scoreDisplay": "°"
  },


  // aug3 · 增三 · C-E-G♯ · maj3=4 aug5=8
  //   增三和弦,根音、大三度、增五度构成
  "aug3": {
  "intervalList": [["maj", 3], ["aug", 5]],
  "cnName": "增三",
  "name": "Augmented",
  "scoreDisplay": "+"
  },


  // maj3b5 · 大三减五 · C-E-G♭ · maj3=4 dim5=6
  //   大三减五和弦,根音、大三度、减五度构成
  "maj3b5": {
  "$base": "maj3",
  "$set": {"5": "dim"},
  "cnName": "大三减五",
  "name": "Major Flat Five",
  "scoreDisplay": "b5"
  },


  // maj3add6 · 大三加六 · C-E-G-A · maj3=4 p5=7 maj6=9
  //   大三加六和弦，在大三和弦基础上增加大六度音
  "maj3add6": {
  "$base": "maj3",
  "$add": [["maj", 6]],
  "cnName": "大三加六",
  "name": "Major Add 6",
  "scoreDisplay": "add6"
  },


  // min3add6 · 小三加六 · C-E♭-G-A · min3=3 p5=7 maj6=9
  //   小三加六和弦，在小三和弦基础上增加大六度音
  "min3add6": {
  "$base": "min3",
  "$add": [["maj", 6]],
  "cnName": "小三加六",
  "name": "Minor Add 6",
  "scoreDisplay": "madd6"
  },


  // maj3add6add9 · 大三加六加九 · C-E-G-A-D · maj3=4 p5=7 maj6=9 maj9=14
  //   大三加六加九和弦，在大三和弦基础上增加大六度和大九度音
  "maj3add6add9": {
  "$base": "maj3add6",
  "$add": [["maj", 9]],
  "cnName": "大三加六加九",
  "name": "Major Add 6 Add 9",
  "scoreDisplay": "add6add9"
  },


  // min3add6add9 · 小三加六加九 · C-E♭-G-A-D · min3=3 p5=7 maj6=9 maj9=14
  //   小三加六加九和弦，在小三和弦基础上增加大六度和大九度音
  "min3add6add9": {
  "$base": "min3add6",
  "$add": [["maj", 9]],
  "cnName": "小三加六加九",
  "name": "Minor Add 6 Add 9",
  "scoreDisplay": "madd6add9"
  },


  // maj3add9 · 大三加九 · C-E-G-D · maj3=4 p5=7 maj9=14
  //   大三加九和弦，在大三和弦基础上增加大九度音
  "maj3add9": {
  "$base": "maj3",
  "$add": [["maj", 9]],
  "cnName": "大三加九",
  "name": "Major Add 9",
  "scoreDisplay": "add9"
  },


  // maj3add11 · 大三加十一 · C-E-G-F · maj3=4 p5=7 p11=17
  //   大三加十一和弦，在大三和弦基础上增加纯十一度音
  "maj3add11": {
  "$base": "maj3",
  "$add": [["p", 11]],
  "cnName": "大三加十一",
  "name": "Major Add 11",
  "scoreDisplay": "add11"
  },


  // min3add9 · 小三加九 · C-E♭-G-D · min3=3 p5=7 maj9=14
  //   小三加九和弦，在小三和弦基础上增加大九度音
  "min3add9": {
  "$base": "min3",
  "$add": [["maj", 9]],
  "cnName": "小三加九",
  "name": "Minor Add 9",
  "scoreDisplay": "madd9"
  },


  // min3add11 · 小三加十一 · C-E♭-G-F · min3=3 p5=7 p11=17
  //   小三加十一和弦，在小三和弦基础上增加纯十一度音
  "min3add11": {
  "$base": "min3",
  "$add": [["p", 11]],
  "cnName": "小三加十一",
  "name": "Minor Add 11",
  "scoreDisplay": "madd11"
  },


  // maj7 · 大七 · C-E-G-B · maj3=4 p5=7 maj7=11
  //   大七和弦，由大三和弦加大七度音构成，音响明亮稳定
  "maj7": {
  "$base": "maj3",
  "$add": [["maj", 7]],
  "cnName": "大七",
  "name": "Major Seventh",
  "scoreDisplay": "M7"
  },


  // dom7 · 属七 · C-E-G-B♭ · maj3=4 p5=7 min7=10
  //   属七和弦，由大三和弦加小七度音构成，具有强烈的解决倾向性
  "dom7": {
  "$base": "maj3",
  "$add": [["min", 7]],
  "cnName": "属七",
  "name": "Dominant Seventh",
  "scoreDisplay": "7"
  },


  // min7 · 小七 · C-E♭-G-B♭ · min3=3 p5=7 min7=10
  //   小七和弦，由小三和弦加小七度音构成，音响柔和常见
  "min7": {
  "$base": "min3",
  "$add": [["min", 7]],
  "cnName": "小七",
  "name": "Minor Seventh",
  "scoreDisplay": "m7"
  },


  // halfdim7 · 半减七 · C-E♭-G♭-B♭ · min3=3 dim5=6 min7=10
  //   半减七和弦，由减三和弦加小七度音构成，也称为小七减五和弦
  "halfdim7": {
  "$base": "dim3",
  "$add": [["min", 7]],
  "cnName": "半减七",
  "name": "Half-Diminished Seventh",
  "scoreDisplay": "ø"
  },


  // dim7 · 减七 · C-E♭-G♭-B♭♭ · min3=3 dim5=6 dim7=9
  //   减七和弦，由减三和弦加减七度音构成，所有音程均为小三度，具有对称性
  "dim7": {
  "$base": "dim3",
  "$add": [["dim", 7]],
  "cnName": "减七",
  "name": "Diminished Seventh",
  "scoreDisplay": "°7"
  },


  // minmaj7 · 小大七 · C-E♭-G-B · min3=3 p5=7 maj7=11
  //   小大七和弦，由小三和弦加大七度音构成，音响独特而神秘
  "minmaj7": {
  "$base": "min3",
  "$add": [["maj", 7]],
  "cnName": "小大七",
  "name": "Minor Major Seventh",
  "scoreDisplay": "mM7"
  },


  // maj7add11 · 大七加十一 · C-E-G-B-F · maj3=4 p5=7 maj7=11 p11=17
  //   大七加十一和弦，在大七和弦基础上增加纯十一度音
  "maj7add11": {
  "$base": "maj7",
  "$add": [["p", 11]],
  "cnName": "大七加十一",
  "name": "Major 7th Add 11",
  "scoreDisplay": "maj7add11"
  },


  // dom7add6 · 属七加六 · C-E-G-A-B♭ · maj3=4 p5=7 maj6=9 min7=10
  //   属七加六和弦，在属七和弦基础上增加大六度音
  "dom7add6": {
  "$base": "maj3add6",
  "$add": [["min", 7]],
  "cnName": "属七加六",
  "name": "Dominant 7th Add 6",
  "scoreDisplay": "7add6"
  },


  // sus2 · 挂二 · C-D-G · maj2=2 p5=7
  //   挂二和弦，用大二度音替代三度音，具有解决到大三或小三和弦的倾向
  "sus2": {
  "intervalList": [["maj", 2], ["p", 5]],
  "cnName": "挂二",
  "name": "Suspended 2nd",
  "scoreDisplay": "sus2"
  },


  // sus4 · 挂四 · C-F-G · p4=5 p5=7
  //   挂四和弦，用纯四度音替代三度音，是最常见的挂留和弦形式
  "sus4": {
  "intervalList": [["p", 4], ["p", 5]],
  "cnName": "挂四",
  "name": "Suspended 4th",
  "scoreDisplay": "sus4"
  },


  // dom7sus2 · 属七挂二 · C-D-G-B♭ · maj2=2 p5=7 min7=10
  //   属七挂二和弦，在属七和弦基础上用大二度音替代三度音
  "dom7sus2": {
  "$base": "sus2",
  "$add": [["min", 7]],
  "cnName": "属七挂二",
  "name": "Dominant 7th Suspended 2nd",
  "scoreDisplay": "7sus2"
  },


  // dom7sus4 · 属七挂四 · C-F-G-B♭ · p4=5 p5=7 min7=10
  //   属七挂四和弦，在属七和弦基础上用纯四度音替代三度音
  "dom7sus4": {
  "$base": "sus4",
  "$add": [["min", 7]],
  "cnName": "属七挂四",
  "name": "Dominant 7th Suspended 4th",
  "scoreDisplay": "7sus4"
  },


  // dom7sus4b9 · 属七挂四减九 · C-F-G-B♭-D♭ · p4=5 p5=7 min7=10 min9=13
  //   属七挂四减九和弦，在属七挂四和弦基础上增加小九度音
  "dom7sus4b9": {
  "$base": "dom7sus4",
  "$add": [["min", 9]],
  "cnName": "属七挂四减九",
  "name": "Dominant 7th Suspended 4th Flat 9",
  "scoreDisplay": "7sus4b9"
  },


  // maj7sus2 · 大七挂二 · C-D-G-B · maj2=2 p5=7 maj7=11
  //   大七挂二和弦，在大七和弦基础上用大二度音替代三度音
  "maj7sus2": {
  "$base": "sus2",
  "$add": [["maj", 7]],
  "cnName": "大七挂二",
  "name": "Major 7th Suspended 2nd",
  "scoreDisplay": "maj7sus2"
  },


  // maj7sus4 · 大七挂四 · C-F-G-B · p4=5 p5=7 maj7=11
  //   大七挂四和弦，在大七和弦基础上用纯四度音替代三度音
  "maj7sus4": {
  "$base": "sus4",
  "$add": [["maj", 7]],
  "cnName": "大七挂四",
  "name": "Major 7th Suspended 4th",
  "scoreDisplay": "maj7sus4"
  },


  // dom9sus4 · 属九挂四 · C-F-G-B♭-D · p4=5 p5=7 min7=10 maj9=14
  //   属九挂四和弦，在属九和弦基础上用纯四度音替代三度音，常用于爵士乐
  "dom9sus4": {
  "$base": "dom7sus4",
  "$add": [["maj", 9]],
  "cnName": "属九挂四",
  "name": "Dominant 9th Suspended 4th",
  "scoreDisplay": "9sus4"
  },


  // maj9sus4 · 大九挂四 · C-F-G-B-D · p4=5 p5=7 maj7=11 maj9=14
  //   大九挂四和弦，在大九和弦基础上用纯四度音替代三度音
  "maj9sus4": {
  "$base": "maj7sus4",
  "$add": [["maj", 9]],
  "cnName": "大九挂四",
  "name": "Major 9th Suspended 4th",
  "scoreDisplay": "maj9sus4"
  },


  // dom13sus4 · 属十三挂四 · C-F-G-B♭-D-A · p4=5 p5=7 min7=10 maj9=14 maj13=21
  //   属十三挂四和弦，在属十三和弦基础上用纯四度音替代三度音
  "dom13sus4": {
