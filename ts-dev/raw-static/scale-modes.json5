/**
 * scale-modes — 调式定义表(46 个,极简源)
 *
 * 本文件是 JSON5 源头,编译产物为 static-data/scale-modes.json(gen:static-data 展开)。
 * 手改只改这里;产物永不手改。
 *
 * ── 极简原则 ─────────────────────────────────────────────
 * 每条只写:键(scaleModeId)+ type(调式主和弦性质:major/minor/halfdim7——
 *   Locrian 系一级七和弦即半减七,燕乐角调式同)+ name(中文名)+ intervalList(6 槽)。
 * 派生字段一律编译时算回:
 *   intervalMap/semitonesList/semitonesMap     intervalList 的 map/半音形态
 *   degreeAlterationsList/Map                  相对自然大调同度数的半音差
 *   scaleModeId                                从键回填
 * 已删化石:family(分段信息保留在注释)/description(由每条第二行注释承载)
 *
 * ── intervalList 语义 ────────────────────────────────────
 * 6 个槽位对应 2~7 度,槽 i 的度数恒为 i+2——**度数由位置决定,不用写**。
 * 缺失的度为 null(五声:宫商角徵羽缺 4、7 度)。
 * 例:GONG(宫调式)= [maj2, maj3, null, p5, maj6, null]。
 *
 * ── 派生公式(编译契约) ─────────────────────────────────
 * semitones[i]        = GAP[type, degree](intervals.json 查表;度≤7 无复合)
 * degreeAlterations[i]= semitones[i] − 自然大调同度半音({2:2,3:4,4:5,5:7,6:9,7:11})
 *
 * ── 记录注释格式 ─────────────────────────────────────────
 * 第一行:中文名 · 度数变音特征(相对自然大调,如「♭3 ♭6 ♭7」;五声标缺度)
 * 第二行:原 description(人读描述)
 */
{

  // ══════ 自然音系(diatonic) ══════

  // 自然大调(= NATURAL_MAJOR 的别名键,同形异名) · (=自然大调)
  //   又称 Ionian 调式，自然大调的 I 级音阶，由 C 大调的 C 进行到高八度的 C，构成音分别为：1 2 3 4 5 6 7 1
  "NATURAL_MAJOR": {
  "type": "major",
  "name": "自然大调",
  "intervalList": [["maj", 2], ["maj", 3], ["p", 4], ["p", 5], ["maj", 6], ["maj", 7]]
  },
  // 自然大调(= NATURAL_MAJOR 的别名键,同形异名) · (=自然大调)
  //   又称 Ionian 调式，自然大调的 I 级音阶，由 C 大调的 C 进行到高八度的 C，构成音分别为：1 2 3 4 5 6 7 1
  "IONIAN": {
  "type": "major",
  "name": "自然大调",
  "intervalList": [["maj", 2], ["maj", 3], ["p", 4], ["p", 5], ["maj", 6], ["maj", 7]]
  },
  // Lydian · #4
  //   自然大调的 IV 级音阶，由 C 大调的 F 进行到高八度的 F，构成音分别为：1 2 3 #4 5 6 7 1
  "LYDIAN": {
  "type": "major",
  "name": "Lydian",
  "intervalList": [["maj", 2], ["maj", 3], ["aug", 4], ["p", 5], ["maj", 6], ["maj", 7]]
  },
  // Mixolydian · ♭7
  //   自然大调的 V 级音阶，由 C 大调的 G 进行到高八度的 G，构成音分别为：1 2 3 4 5 6 b7 1
  "MIXOLYDIAN": {
  "type": "major",
  "name": "Mixolydian",
  "intervalList": [["maj", 2], ["maj", 3], ["p", 4], ["p", 5], ["maj", 6], ["min", 7]]
  },
  // 自然小调(= NATURAL_MINOR 的别名键,同形异名) · ♭3 ♭6 ♭7
  //   又称 Aeolian 调式，自然大调的 VI 级音阶，由 C 大调的 A 进行到高八度的 A，构成音分别为：1 2 b3 4 5 b6 b7 1
  "NATURAL_MINOR": {
  "type": "minor",
  "name": "自然小调",
  "intervalList": [["maj", 2], ["min", 3], ["p", 4], ["p", 5], ["min", 6], ["min", 7]]
  },
  // 自然小调(= NATURAL_MINOR 的别名键,同形异名) · ♭3 ♭6 ♭7
  //   又称 Aeolian 调式，自然大调的 VI 级音阶，由 C 大调的 A 进行到高八度的 A，构成音分别为：1 2 b3 4 5 b6 b7 1
  "AEOLIAN": {
  "type": "minor",
  "name": "自然小调",
  "intervalList": [["maj", 2], ["min", 3], ["p", 4], ["p", 5], ["min", 6], ["min", 7]]
  },
  // Dorian · ♭3 ♭7
  //   自然大调的 II 级音阶，由 C 大调的 D 进行到高八度的 D，构成音分别为：1 2 b3 4 5 6 b7 1
  "DORIAN": {
  "type": "minor",
  "name": "Dorian",
  "intervalList": [["maj", 2], ["min", 3], ["p", 4], ["p", 5], ["maj", 6], ["min", 7]]
  },
  // Phrygian · ♭2 ♭3 ♭6 ♭7
  //   自然大调的 III 级音阶，由 C 大调的 E 进行到高八度的 E，构成音分别为：1 b2 b3 4 5 b6 b7 1
  "PHRYGIAN": {
  "type": "minor",
  "name": "Phrygian",
  "intervalList": [["min", 2], ["min", 3], ["p", 4], ["p", 5], ["min", 6], ["min", 7]]
  },
  // Locrian · ♭2 ♭3 ♭5 ♭6 ♭7
  //   自然大调的 VII 级音阶，由 C 大调的 B 进行到高八度的 B，构成音分别为：1 b2 b3 4 b5 b6 b7 1
  "LOCRIAN": {
  "type": "halfdim7",
  "name": "Locrian",
  "intervalList": [["min", 2], ["min", 3], ["p", 4], ["dim", 5], ["min", 6], ["min", 7]]
  },

  // ══════ 和声大调系(harmonic-major) ══════

  // 和声大调 · ♭6
  //   把自然大调的第六级音降低一个半音，构成音分别为：1 2 3 4 5 b6 7 1
  "HARMONIC_MAJOR": {
  "type": "major",
  "name": "和声大调",
  "intervalList": [["maj", 2], ["maj", 3], ["p", 4], ["p", 5], ["min", 6], ["maj", 7]]
  },

  // ══════ 和声小调系(harmonic-minor) ══════

  // 和声小调 · ♭3 ♭6
  //   把自然小调的第七级音升高一个半音，构成音分别为：1 2 b3 4 5 b6 7 1
  "HARMONIC_MINOR": {
  "type": "minor",
  "name": "和声小调",
  "intervalList": [["maj", 2], ["min", 3], ["p", 4], ["p", 5], ["min", 6], ["maj", 7]]
  },
  // Phrygian Dominant · ♭2 ♭6 ♭7
  //   和声小调的 V 级音阶，构成音分别为：1 b2 3 4 5 b6 b7 1，常用于弗拉门戈和中东风格
  "PHRYGIAN_DOMINANT": {
  "type": "major",
  "name": "Phrygian Dominant",
  "intervalList": [["min", 2], ["maj", 3], ["p", 4], ["p", 5], ["min", 6], ["min", 7]]
  },
  // Locrian #6 · ♭2 ♭3 ♭5 ♭7
  //   和声小调的 II 级音阶，构成音分别为：1 b2 b3 4 b5 6 b7 1
  "LOCRIAN_SHARP6": {
  "type": "halfdim7",
  "name": "Locrian #6",
  "intervalList": [["min", 2], ["min", 3], ["p", 4], ["dim", 5], ["maj", 6], ["min", 7]]
  },
  // Ionian #5 · #5
  //   和声小调的 III 级音阶，构成音分别为：1 2 3 4 #5 6 7 1
  "IONIAN_SHARP5": {
  "type": "major",
  "name": "Ionian #5",
  "intervalList": [["maj", 2], ["maj", 3], ["p", 4], ["aug", 5], ["maj", 6], ["maj", 7]]
  },
  // Dorian #4 · ♭3 #4 ♭7
  //   和声小调的 IV 级音阶，又称乌克兰多利亚，构成音分别为：1 2 b3 #4 5 6 b7 1
  "DORIAN_SHARP4": {
  "type": "minor",
  "name": "Dorian #4",
  "intervalList": [["maj", 2], ["min", 3], ["aug", 4], ["p", 5], ["maj", 6], ["min", 7]]
  },
  // Lydian #2 · #2 #4
