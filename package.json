{
  "name": "music12",
  "version": "3.1.0",
  "description": "TypeScript library for music theory calculations - notes, intervals, chords, scales",
  "author": "guohub8080",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/guohub8080/music12.git"
  },
  "keywords": [
    "music",
    "music-theory",
    "chord",
    "scale",
    "note",
    "interval",
    "typescript"
  ],
  "scripts": {
    "dev": "pnpm vite",
    "build": "del-cli dist/* && vite build --config vite.lib.config.ts && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build",
    "gen:data": "npx tsx packages/music12-gen/src/index.ts",
    "gen:golden": "npx tsx tools/extract-golden.ts",
    "test": "vitest run",
    "test:ts": "vitest run",
    "build:cpp": "cd packages/music12-cpp && mkdir -p build && cd build && cmake .. -DCMAKE_BUILD_TYPE=Release && cmake --build . --parallel 4",
    "test:cpp": "cd packages/music12-cpp/build && MUSIC12_ROOT=$(pwd)/../../.. ./music12_tests",
    "verify:equivalence": "cd packages/music12-cpp/build && MUSIC12_ROOT=$(pwd)/../../.. ./verify_equivalence",
    "verify:all": "pnpm test:ts && pnpm test:cpp && pnpm verify:equivalence"
  },
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.mjs",
  "types": "./dist/types/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.mjs",
      "require": "./dist/cjs/index.cjs"
    },
    "./note": {
      "types": "./dist/types/Note/index.d.ts",
      "import": "./dist/esm/note.mjs",
      "require": "./dist/cjs/note.cjs"
    },
    "./interval": {
      "types": "./dist/types/Interval/index.d.ts",
      "import": "./dist/esm/interval.mjs",
      "require": "./dist/cjs/interval.cjs"
    },
    "./scale": {
      "types": "./dist/types/Scale/index.d.ts",
      "import": "./dist/esm/scale.mjs",
      "require": "./dist/cjs/scale.cjs"
    },
    "./chord": {
      "types": "./dist/types/Chord/index.d.ts",
      "import": "./dist/esm/chord.mjs",
      "require": "./dist/cjs/chord.cjs"
    },
    "./chord-formula": {
      "types": "./dist/types/ChordFormula/index.d.ts",
      "import": "./dist/esm/chord-formula.mjs",
      "require": "./dist/cjs/chord-formula.cjs"
    },
    "./find": {
      "types": "./dist/types/Find/index.d.ts",
      "import": "./dist/esm/find.mjs",
      "require": "./dist/cjs/find.cjs"
    },
    "./stave": {
      "types": "./dist/types/Stave/index.d.ts",
      "import": "./dist/esm/stave.mjs",
      "require": "./dist/cjs/stave.cjs"
    },
    "./radix": {
      "types": "./dist/types/common/radix/index.d.ts",
      "import": "./dist/esm/radix.mjs",
      "require": "./dist/cjs/radix.cjs"
    },
    "./circle-of-fifths": {
      "types": "./dist/types/CircleOfFifths/index.d.ts",
      "import": "./dist/esm/circle-of-fifths.mjs",
      "require": "./dist/cjs/circle-of-fifths.cjs"
    },
    "./factory": {
      "types": "./dist/types/factory/index.d.ts",
      "import": "./dist/esm/factory.mjs",
      "require": "./dist/cjs/factory.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "AGENTS.md",
    "CHANGELOG.md"
  ],
  "dependencies": {
    "chinese-numbering": "^1.0.0",
    "collect.js": "^4.36.1",
    "es-toolkit": "^1.49.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "ahooks": "^3.9.6",
    "del-cli": "^7.0.0",
    "eslint": "^10.0.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.0",
    "immer": "^11.1.4",
    "jsdom": "^28.1.0",
    "pnpm": "^10.30.0",
    "prettier": "^3.8.1",
    "ramda": "^0.32.0",
    "react": "^19.2.4",
    "react-async": "^10.0.1",
    "react-dom": "^19.2.4",
    "react-router": "^7.13.0",
    "react-router-dom": "^7.13.0",
    "react-use": "^17.6.0",
    "typescript-eslint": "^8.56.0",
    "usehooks-ts": "^3.1.1",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  }
}